# Docker Environment Settings for .env
APP_NAME=Gentleman
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker Ports (Optional overrides)
DOCKER_WEB_PORT=8000
DOCKER_DB_PORT=3307
DOCKER_PMA_PORT=8080

# Database Configuration for Docker
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gentleman
DB_USERNAME=gentleman
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
